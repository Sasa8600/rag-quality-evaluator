# Copy to .env (or export these as real env vars) — only needed when LLM_PROVIDER=cloud.
# Default is LLM_PROVIDER=ollama, which needs none of this and keeps everything local.

# ollama | cloud
LLM_PROVIDER=cloud

# Used only when LLM_PROVIDER=cloud — generation, via Groq (free tier, OpenAI-compatible)
# Get a key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Used only when LLM_PROVIDER=cloud — embeddings, via Google Gemini (free tier)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — approximate $ cost tracking for evaluation runs. Get current per-model
# pricing from https://groq.com/pricing and fill these in, or leave blank to skip
# cost computation (token counts are still tracked and stored either way).
GROQ_PRICE_PER_M_INPUT=
GROQ_PRICE_PER_M_OUTPUT=
